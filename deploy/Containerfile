FROM docker.io/library/rust:1.99-slim AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY migrations ./migrations
COPY src ./src
RUN CARGO_TARGET_DIR=/build/target cargo build --release --bins

FROM docker.io/library/debian:12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /app --create-home matchs

COPY --from=builder /build/target/release/server /app/bin/server
COPY --from=builder /build/target/release/ingest /app/bin/ingest
RUN chown -R matchs:matchs /app

USER matchs
WORKDIR /app
ENV APP_ENV=production \
    BIND_ADDR=0.0.0.0:8080 \
    RUST_LOG=info
EXPOSE 8080
ENTRYPOINT ["/app/bin/server"]
CMD ["serve"]
