{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy api:8080 {
		health_uri /healthz
		health_interval 10s
		health_timeout 5s
	}
}
