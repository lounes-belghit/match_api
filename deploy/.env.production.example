APP_ENV=production
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

POSTGRES_DB=matchs
POSTGRES_USER=matchs
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_init-secrets_sh
DATABASE_URL=postgres://matchs:CHANGE_ME_GENERATE_WITH_init-secrets_sh@db:5432/matchs
REDIS_URL=redis://redis:6379

APP_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS

BIND_ADDR=0.0.0.0:8080
DEFAULT_QUOTA=100000
RATE_PER_MIN=300
CACHE_TTL_SECS=60
STALE_AFTER_SECS=900
INGEST_ALERT_AFTER_SECS=3600
SESSION_TTL_HOURS=168
COOKIE_SECURE=true
REGISTRATIONS_ENABLED=true
DB_MAX_CONNECTIONS=20
DB_ACQUIRE_TIMEOUT_SECS=10
SOURCE_TIMEOUT_SECS=20
INGEST_CONCURRENCY=6
INGEST_MAX_RETRIES=3
INGEST_RETRY_BASE_MS=500
RUST_LOG=info
